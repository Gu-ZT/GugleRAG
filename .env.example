SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Supported:
# - sqlite://data/guglerag.db?mode=rwc
# - mysql://user:password@127.0.0.1:3306/guglerag
# - postgresql://user:password@127.0.0.1:5432/guglerag
DATABASE_URL=sqlite://data/guglerag.db?mode=rwc

JWT_SECRET=change-me-to-at-least-32-characters
REGISTRATION_ENABLED=true

EMBEDDING_PROVIDER=stub
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_URL=https://api.siliconflow.cn/v1/embeddings
SILICONFLOW_URL=https://api.siliconflow.cn
SILICONFLOW_API_KEY=

RERANKER_ENABLED=false
RERANKER_PROVIDER=siliconflow
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_URL=

MCP_ENABLED=true
MCP_AUTH_REQUIRED=false

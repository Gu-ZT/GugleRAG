SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Supported:
# - sqlite://data/guglerag.db
# - mysql://user:password@127.0.0.1:3306/guglerag
# - postgresql://user:password@127.0.0.1:5432/guglerag
DATABASE_URL=sqlite://data/guglerag.db

# Development fallback store used until the SQLx persistence layer is wired.
GUGLERAG_DATA=data.json

JWT_SECRET=change-me-to-at-least-32-characters

EMBEDDING_PROVIDER=stub
EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_URL=https://api.siliconflow.cn
SILICONFLOW_API_KEY=

MCP_ENABLED=true
MCP_AUTH_REQUIRED=false
